# В демонстрационном стенде используются учётные данные postgres/postgres.
# В проде так делать нельзя — используйте отдельного пользователя и сложный пароль.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=demo_pgbouncer

# VIP-пользователи (для разметки арбитром)
VIP_USERS=vip,director,ceo

# Вытеснение read-only LOW-запросов
PREEMPTION_ENABLED=true

# Нагрузка генератора
CONCURRENT_VIP=10
CONCURRENT_NORMAL=50
CONCURRENT_LOW=20
DURATION_SECONDS=120

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
